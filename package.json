{
  "name": "asc-pilot",
  "version": "0.1.0",
  "private": true,
  "description": "ASC-Pilot \u2014 finds local businesses without a website, generates one for them, and offers it as a subscription.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "check:env": "tsx scripts/check-env.ts",
    "overture:fetch": "tsx scripts/fetch-overture.ts",
    "discover": "tsx scripts/discover.ts",
    "generate": "tsx scripts/generate.ts",
    "reslug": "tsx scripts/reslug.ts",
    "coverage": "tsx scripts/coverage.ts",
    "outreach": "tsx scripts/outreach.ts",
    "logos": "tsx scripts/logos.ts",
    "enrich:osm": "tsx scripts/enrich-osm.ts",
    "rerender": "tsx scripts/rerender.ts",
    "stripe:check": "tsx scripts/stripe-check.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@duckdb/node-api": "^1.5.5-r.4",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "^17.4.2",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "^22.6.0",
    "svix": "^2.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prisma": "7.10.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
