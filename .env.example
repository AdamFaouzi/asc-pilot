# ASC-Pilot configuration.
# Copy to .env and fill in what the phase you're working on needs.
# Only DATABASE_URL is required to boot; everything else fails loudly at the
# point of use, naming the variable it wants.

# --- Core (Phase 1) ----------------------------------------------------------
DATABASE_URL="postgresql://ascpilot:ascpilot@localhost:5432/ascpilot?schema=public"
APP_URL="http://localhost:3000"
# Domain the generated preview sites are served under.
PREVIEW_DOMAIN="localhost:3000"
LOG_LEVEL="info"

# --- Discovery (Phase 2) -----------------------------------------------------
# "overture" is free open data (no key, no billing). "google" bills per call
# and puts websiteUri in its priciest field tier. "mock" uses fixtures.
PLACES_PROVIDER="overture"
GOOGLE_PLACES_API_KEY=""

# Overture release to read. Bump when they ship a new one (roughly monthly),
# then re-run: npm run overture:fetch
OVERTURE_RELEASE="2026-08-19.0"
OVERTURE_DATA_DIR="./data/overture"
# Overture's own existence score. Below this a record is too doubtful to pitch.
OVERTURE_MIN_CONFIDENCE="0.5"

# "static" is a built-in gazetteer of Cypriot towns — offline, no rate limit.
# "nominatim" resolves arbitrary places but requires an identifying User-Agent
# with a contact address, per OSM's usage policy.
GEOCODE_PROVIDER="static"
NOMINATIM_USER_AGENT=""

# Secondary check: probe the domain behind a business's email to see whether it
# actually serves a page. This is what stops us emailing businesses that do
# have a website the dataset simply doesn't know about.
WEBSITE_PROBE_ENABLED="true"
WEBSITE_PROBE_TIMEOUT_MS="5000"
WEBSITE_PROBE_CONCURRENCY="5"

# --- Site generation (Phase 3) -----------------------------------------------
GENERATOR_PROVIDER="mock"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"

# --- Hosting (Phase 3) -------------------------------------------------------
# "local" writes sites to ./generated-sites and serves them from this app.
HOSTING_PROVIDER="local"
VERCEL_TOKEN=""
VERCEL_PROJECT_ID=""
VERCEL_TEAM_ID=""

# --- Outreach (Phase 4) ------------------------------------------------------
# "console" logs the email instead of sending it. Keep it until Phase 4 is
# reviewed — a transactional provider, never a personal Gmail.
EMAIL_PROVIDER="console"
RESEND_API_KEY=""
RESEND_WEBHOOK_SECRET=""
OUTREACH_FROM_EMAIL=""
OUTREACH_FROM_NAME="ASC-Pilot"
OUTREACH_REPLY_TO=""
# Required in commercial email under EU rules: a real postal address.
OUTREACH_POSTAL_ADDRESS=""
# Phase 4. Offered in the email as an alternative to replying.
OUTREACH_PHONE=""
# Signs unsubscribe tokens. Generate with: openssl rand -hex 32
UNSUBSCRIBE_SECRET=""

# --- Billing (Phase 5) -------------------------------------------------------
# The price is NOT set here. It lives on the Stripe Price object, so changing it
# in the Stripe dashboard changes the site CTA, the outreach email, and the
# dashboard with no deploy. Existing subscribers keep the price they signed up
# at — Stripe does that, and Subscription.amountCents records what was actually
# charged, so MRR never assumes everyone pays today's rate.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
# The recurring Price object, e.g. price_1AbC…  Create it in Stripe, not here.
STRIPE_PRICE_ID=""

# --- Safety rails ------------------------------------------------------------
# Master switch for anything that leaves the building. Leave false until the
# Cyprus/EU compliance review in docs/COMPLIANCE.md is done.
OUTREACH_ENABLED="false"
OUTREACH_DAILY_LIMIT="25"
OUTREACH_MIN_INTERVAL_SECONDS="120"
# Contacts below this confidence go to manual review instead of automation.
CONTACT_CONFIDENCE_THRESHOLD="0.6"
